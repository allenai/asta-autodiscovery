# .dockerignore - Used by api/Dockerfile, scripts/Dockerfile and
# packages/autodiscovery/Dockerfile (every build whose context is the repo root)

# Ignore common development files
.git
.github
.venv
.pytest_cache
.ruff_cache
.vscode
.claude
**/__pycache__
**/*.pyc
**/.DS_Store

# Ignore other service directories. Of ui/, only what the autodiscovery image
# needs to build the HTML report's run view (see ui/vite.report.config.ts).
ui/*
!ui/package.json
!ui/yarn.lock
!ui/tsconfig.json
!ui/report.html
!ui/vite.config.ts
!ui/vite.report.config.ts
!ui/src
proxy
sonar
autods-viz
devtools
docs

# Ignore markdown and config files
*.md
.gitignore
.envrc
justfile
mkdocs.yml
ruff.toml
docker-compose.yaml
mcpdoc.json

# Keep what we need
!packages/
!api/
!scripts/
!pyproject.toml
!uv.lock

# A locally built run view; the autodiscovery image builds its own from ui/.
packages/autodiscovery/src/autodiscovery/report_viewer
