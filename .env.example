# INSTRUCTIONS
#
# - Copy this file into /.env
# - Get keys from 1Password or Google Cloud Console

GOOGLE_ACCESS_KEY_ID=GOOG1E...
GOOGLE_ACCESS_KEY_SECRET=...
# Path to your GCP key file. Use an ABSOLUTE path when using the docker job backend
# (the default): the API bind-mounts this file into each job container, and the
# host daemon needs an absolute source path.
GOOGLE_APPLICATION_CREDENTIALS=/Users/you/asta/secrets/gcp-key.json

# ===========================================================================
# Persistence (swappable). See docs/design/storage-backends.md.
# ===========================================================================
# Where run metadata, uploaded datasets, and results are stored:
#   local (default) - a directory on this host, bind-mounted into the containers.
#                     No cloud account or credentials needed.
#   gcs             - a Google Cloud Storage bucket (GCS_BUCKET below). Required
#                     for JOB_BACKEND=gcp and CODE_EXECUTION_BACKEND=modal.
STORAGE_BACKEND=local
# local backend: host directory holding all run data. Defaults to ./data.
# Use an ABSOLUTE path: the docker job backend bind-mounts each run's subtree into
# its job container, and the host daemon needs an absolute source path.
# STORAGE_DIR=/Users/you/asta/data

# gcs backend only.
GCS_BUCKET=autodiscovery
GCP_PROJECT=example-gcp-project

# Job backend for AutoDiscovery runs: "docker" (local containers, default) or
# "gcp" (Cloud Run). With the default, `docker compose up` launches each job as a
# local container — build the image first with `docker compose build autodiscovery`.
# Set JOB_BACKEND=gcp to run jobs on Cloud Run instead.
JOB_BACKEND=docker
# docker backend: image the backend launches for each job. Build it locally with
# `docker compose build autodiscovery` (tags it as this value).
AUTODISCOVERY_IMAGE=autodiscovery:dev

# Code-execution backend for the AD job's LLM-generated code:
#   process (default) - isolated subprocess inside the job container; no cloud
#                       dependency (Modal not required). Reads the dataset from
#                       the job's data mount.
#   local             - in-process, no isolation.
#   modal             - remote Modal sandbox; mounts only the per-job data,
#                       read-only. Required for multi-user GCP deployments, and
#                       requires STORAGE_BACKEND=gcs.
# Untrusted generated code runs wherever the data is mounted, so this interacts
# with JOB_BACKEND and AUTH_PROVIDER. See docs/configuration.md for the safe
# combinations before changing it for a multi-user deployment.
CODE_EXECUTION_BACKEND=process

MODAL_TOKEN_ID=...
MODAL_TOKEN_SECRET=...
MODAL_IMAGE_BUILDER_VERSION=2025.06
MODAL_ENVIRONMENT=AutoDiscovery
# Name of the Modal secret holding the GCS credentials the sandbox uses to mount
# datasets. Required only when CODE_EXECUTION_BACKEND=modal: it must name a real
# secret in MODAL_ENVIRONMENT, or every run fails at sandbox creation with
# "Secret '...' not found". Unused (and the MODAL_* vars above are unused) with
# the default process/local code-execution backend.
MODAL_BUCKET_SECRET=...
# Modal app the sandboxes run under (created on demand). Override if needed.
# MODAL_APP_NAME=asta-autodiscovery

OPENAI_API_KEY=...

VERTEX_PROJECT_ID=example-gcp-project
VERTEX_LOCATION=global

# LLM retry/backoff configuration
LLM_RETRY_MAX_RETRIES=5
LLM_RETRY_INITIAL_DELAY_SECONDS=1.0
LLM_RETRY_MAX_DELAY_SECONDS=20.0

# Asta context service (artifact storage + metadata).
ASTA_CONTEXT_SERVICE_URL=
ASTA_CONTEXT_SERVICE_API_KEY=

# For email job to lookup user emails
AUTH0_MGMT_DOMAIN=
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=

# Email job: mail server and from-address (required to send; port defaults to 25)
SMTP_SERVER=
SENDER_EMAIL=
# SMTP_PORT=25

# ===========================================================================
# Authentication provider (swappable). See docs/design/auth-providers.md.
# ===========================================================================
# Which provider to activate: none (default) | auth0 | password_file
# Default `none` is zero-config for local runs (unauthenticated fixed local user).
# Set auth0 or password_file for any real/multi-user deployment.
AUTH_PROVIDER=none

# --- auth0 provider ---
# AUTH0_DOMAIN and AUTH0_AUDIENCE configure JWT validation (see docker-compose).
# AUTH0_CLIENT_ID is served to the UI via /api/auth/config (runtime SPA config).
AUTH0_CLIENT_ID=

# --- password_file provider ---
# Directory holding the user store (fixed filename passwddb.json inside it),
# administered with api/scripts/auth_admin.py. docker-compose mounts this dir.
# AUTH_PASSWORD_DIR=./secrets
# Secret used to sign HS256 session tokens. Use a long random value (>= 32 bytes).
# AUTH_SESSION_SECRET=
# Optional session lifetime in seconds (default 43200 = 12h).
# AUTH_SESSION_TTL=43200

# --- none provider (desktop mode) ---
# No configuration: every request is a fixed "local" user with all permissions.
